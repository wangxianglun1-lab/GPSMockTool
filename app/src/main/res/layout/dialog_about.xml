<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="310dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:src="@android:drawable/ic_menu_mylocation"
            app:tint="#2196F3"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="幻迹 GPS"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_about_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="当前版本：V 3.6.6 (Build 28)"
            android:textColor="#2196F3"
            android:textSize="12sp"
            android:background="#E3F2FD"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="【极客声明】\n软件是一款基于 Android 底层 Mock 技术的个人研究作品，仅用于地图反作弊技术对抗、开发者位置调试及个人技术测试。请勿用于任何恶意打卡或不正当竞争场景。"
            android:textColor="#555555"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="© 2026 幻迹技术工作室.\nAll Rights Reserved."
            android:textColor="#999999"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="22dp"/>

        <Button
            android:id="@+id/btn_dialog_about_close"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="关闭"
            android:textSize="14sp"
            android:textColor="#2196F3"
            android:textStyle="bold"
            android:backgroundTint="#E3F2FD"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>